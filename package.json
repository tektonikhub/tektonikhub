{
  "name": "tektonik-hub",
  "version": "0.2.0",
  "private": true,
  "description": "Tektonik hub: aplicación Next.js y React con arquitectura TypeScript multiempresa.",
  "engines": { "node": ">=20.18.0" },
  "scripts": {
    "predev": "node scripts/sync-public.cjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:llm": "node server/llm.cjs",
    "accounts:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-insforge.mts",
    "prebuild": "node scripts/sync-public.cjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components hooks lib next.config.ts proxy.ts scripts/bootstrap-insforge.mts \"tests/next-*.ts\"",
    "test:next": "tsx --test tests/next-studio.test.ts tests/next-platform.test.ts tests/next-auth.test.ts tests/next-mi-flow.test.ts tests/next-azure.test.ts tests/next-portable.test.ts tests/next-portable-persistence.test.ts",
    "test:next:auth": "node tests/next-auth-browser.cjs",
    "test:next:llm": "node tests/next-llm.cjs",
    "test": "node --test tests/studio-engine.test.cjs tests/studio-engine-sandbox.test.cjs tests/dashboard-kit.test.cjs tests/local-server.test.cjs"
  },
  "dependencies": {
    "@insforge/sdk": "^1.5.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.3",
    "playwright": "^1.51.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

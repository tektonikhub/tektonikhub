# Nunca habilitar Azure local en un despliegue público: el handler lo rechaza en producción.
BLK_ENABLE_LOCAL_LLM=false
BLK_LOCAL_LLM_PORT=8027
# Configuración obligatoria de acceso real. Copiar a .env.local y completar con el proyecto vinculado.
NEXT_PUBLIC_INSFORGE_URL=https://vxpd968k.eu-central.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://vxpd968k.insforge.site
APP_URL=https://vxpd968k.insforge.site
# Solo servidor: resolución de usuarios, límite de intentos y envío de activaciones.
# Nunca añadir API keys ni service-role keys en variables NEXT_PUBLIC_*.
INSFORGE_API_KEY=
